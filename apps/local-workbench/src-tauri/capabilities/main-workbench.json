{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workbench",
  "description": "Main local workbench documents, background chooser, source accounts and favorites, and its own title bar controls.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "workbench-documents",
    "workbench-updates",
    "workbench-asmr",
    "workbench-accounts",
    "workbench-library",
    "workbench-reader",
    "workbench-reader-host",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "workbench-downloads"
  ]
}
